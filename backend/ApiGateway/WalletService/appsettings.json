{
  "ConnectionStrings": {
    "WalletDb": "Host=localhost;Port=5433;Database=database;Username=admin;Password=admin"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:50053",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://localhost:8761/eureka/",
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true
    },
    "Instance": {
      "AppName": "Wallet-Service",
      "Port": 8081,
      "HostName": "localhost"
    }
  }
}
