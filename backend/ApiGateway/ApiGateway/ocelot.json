{
  "Routes": [
    {
      "UpstreamPathTemplate": "/wallets/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Patch", "Options" ],
      "DownstreamPathTemplate": "/api/v1/wallets/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "Wallet-Service",
      "UseServiceDiscovery": true,
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    }
  ],
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {      "Type": "Eureka"
    }
  }
}